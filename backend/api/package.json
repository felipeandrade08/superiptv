    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "@fastify/jwt": "^9.1.0",
    "pg": "^8.13.1",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "@types/pg": "^8.11.10",
    "@types/bcryptjs": "^2.4.6"
  }
}
